# API base for the browser (no trailing slash). Used in dev and production builds.
# Deployed backend:
VITE_API_BASE_URL=https://sober-watch.onrender.com

# To use a local API instead, point here and run `npm run dev:backend`, or leave
# VITE_API_BASE_URL unset in .env.development only and rely on the Vite proxy in vite.config.ts.
