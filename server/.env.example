# Server Configuration
PORT=4000

# Supabase PostgreSQL Connection
# Get DATABASE_URL from Supabase: https://app.supabase.com/project/_/settings/database
DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# JWT Secret - MUST change in production
JWT_SECRET=replace_with_strong_secret

# Frontend URL
CLIENT_ORIGIN=http://localhost:5173

# Email Alert Configuration (SMTP) - Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=soberwatch@localhost
# Recipient for gas alert emails (/api/alert); required for that feature
ALERT_EMAIL=
# Optional extra recipient for alcohol alert emails
DEFAULT_ALERT_EMAIL=