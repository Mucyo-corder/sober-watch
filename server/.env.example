PORT=4000
# For production, use DATABASE_URL (from Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database
# For local development, use individual DB settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soberwatch
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=replace_with_strong_secret
CLIENT_ORIGIN=http://localhost:8080

# Email Alert Configuration (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=soberwatch@localhost
ALERT_EMAIL=
