# Server Configuration
PORT=4000

# --- Option A (recommended): full connection string from Supabase → Settings → Database ---
# Use "URI" for direct Postgres, or pooler connection string from "Connection pooling" if you use port 6543.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Option B: discrete fields (matches Supabase pooler UI: user is often postgres.xxxxx) ---
# DB_HOST=aws-0-eu-central-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your_project_ref
# DB_PASSWORD=your_database_password

# Optional: Supabase REST/Auth keys (server-only; do not expose service role to the browser)
# SUPABASE_URL=https://your_project_ref.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# JWT Secret - MUST change in production
JWT_SECRET=replace_with_strong_secret

# Frontend URL (QR links + CORS allowlist). Local: match Vite port. Production: your Render static site URL (no trailing slash).
CLIENT_ORIGIN=http://localhost:8080
# Example — your deployed UI:
# CLIENT_ORIGIN=https://frontend-9wly.onrender.com

# Extra origins (comma-separated, no spaces). Use if the SPA is reachable under several URLs.
# CLIENT_ORIGINS=https://frontend-9wly.onrender.com,https://www.yourdomain.com

# Email Alert Configuration (SMTP) - Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=soberwatch@localhost
ALERT_EMAIL=
DEFAULT_ALERT_EMAIL=
