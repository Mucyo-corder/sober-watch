# Server Configuration
PORT=4000

# --- Option A (recommended): full connection string from Supabase → Settings → Database ---
# Use "URI" for direct Postgres, or pooler connection string from "Connection pooling" if you use port 6543.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Option B: discrete fields (matches Supabase pooler UI: user is often postgres.xxxxx) ---
# DB_HOST=aws-0-eu-central-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your_project_ref
# DB_PASSWORD=your_database_password

# Optional: Supabase REST/Auth keys (server-only; do not expose service role to the browser)
# SUPABASE_URL=https://your_project_ref.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Set to true on Render temporarily to include `detail`/`code` on uncaught 500s (then turn off).
# EXPOSE_ERROR_DETAILS=true

# JWT Secret - MUST change in production
JWT_SECRET=replace_with_strong_secret

# Frontend URL (QR links + merged into CORS allowlist). Local: match your SPA port. Production: URL users open in the browser (no trailing slash).
CLIENT_ORIGIN=http://localhost:8080
# Example — your deployed UI:
# CLIENT_ORIGIN=https://frontend-9wly.onrender.com

# Comma-separated browser origins for CORS (no trailing slashes). Set every host:port you use locally and all deployed SPA/API origins you need.
# CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://localhost:8085,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:8081,http://127.0.0.1:8082,http://127.0.0.1:8083,http://127.0.0.1:8084,http://127.0.0.1:8085,http://127.0.0.1:5173,https://sober-watch.onrender.com,https://frontend.onrender.com,https://frontend-9wly.onrender.com

# Extra origins (comma-separated). Same format as CORS_ALLOWED_ORIGINS; merged into the allowlist.
# CLIENT_ORIGINS=https://frontend-9wly.onrender.com,https://www.yourdomain.com

# Optional alias for extra origins (comma-separated).
# ALLOWED_ORIGINS=

# Email Alert Configuration (SMTP) - Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=soberwatch@localhost
ALERT_EMAIL=
DEFAULT_ALERT_EMAIL=
